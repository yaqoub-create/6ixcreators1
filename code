      <form class="cform" id="cform" onsubmit="return false">
        <label>Name<input name="Name" required></label>
        <label>Email<input name="Email" type="email" required></label>
        <label>Message<textarea name="Message" rows="4" required></textarea></label>
        <button class="btn" type="button" id="csend">Send message</button>
      </form>
    </div>
    <div class="right">
      <h3>Email</h3>
      <a class="bigmail" href="mailto:info@6ixcreators.com">info@6ixcreators.com</a>
      <p>Prefer to write us directly? Email anytime.</p>
    </div>
  </div>

</div>

