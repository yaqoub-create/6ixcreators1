  <section style="border-top:0">
    <a href="#">← Back to home</a>
    <h2 style="margin-top:18px;font-size:clamp(34px,6vw,60px)">Post a campaign</h2>
    <p style="color:var(--muted);max-width:52ch">Tell us about your product and budget. We’ll reply with a shortlist of creators who fit.</p>
    <div class="formwrap"><div class="panel"><h3>Tell us about your campaign</h3><p>The form opens in a new tab and takes about two minutes. We reply to every submission by email.</p><a class="btn" href="https://docs.google.com/forms/d/e/1FAIpQLSfksPbXwr7Ylq4XpdduqL6GVNxDA5TG2QavchKi0VXFhc0_FQ/viewform" target="_blank" rel="noopener">Open the brand form</a></div></div>
  </section>
</div>

<div id="view-creator" hidden>
  <section style="border-top:0">
    <a href="#">← Back to home</a>
    <h2 style="margin-top:18px;font-size:clamp(34px,6vw,60px)">Join as a creator</h2>
    <p style="color:var(--muted);max-width:52ch">Share your profile and we’ll send you brand deals that suit your audience.</p>
    <div class="formwrap"><div class="panel"><h3>Apply to join</h3><p>The form opens in a new tab and takes about two minutes. We reply to every submission by email.</p><a class="btn" href="https://docs.google.com/forms/d/e/1FAIpQLSeB9Kj8tEIno3ZsGWqvTtseB6v-m9kE-GWS5PjL9HzUqvEYNg/viewform" target="_blank" rel="noopener">Open the creator form</a></div></div>
  </section>
</div>

  <footer>© 2026 6ix Creators · Brampton, Ontario · yuvraj@6ixcreators.com</footer>
</div>

</div>
<script>
(function(){

var deals=[
  {b:"Sample Lip Co.",n:"Makeup",d:"1 Reel + 3 Stories",p:"$300–$500"},
  {b:"Sample Glow Lab",n:"Skincare",d:"2 TikToks",p:"$400–$700"},
  {b:"Sample Curl House",n:"Hair",d:"1 Reel + product gifting",p:"$250–$400"},
  {b:"Sample Lash Studio",n:"Makeup",d:"3 Stories + 1 post",p:"$200–$350"},
  {b:"Sample Dew Skin",n:"Skincare",d:"1 YouTube Short",p:"$300–$450"}
];
var list=document.getElementById("board-list");
function render(f){
  list.innerHTML="";
  deals.filter(function(x){return f==="all"||x.n===f}).forEach(function(x){
    var e=document.createElement("div");e.className="deal";
    e.innerHTML="<div><b>"+x.b+"</b><small>"+x.d+"</small></div><span class=\"tag\">"+x.n+"</span><div><b>"+x.p+"</b><small>Budget</small></div><a class=\"btn\" href=\"#creator\">Apply</a>";
    list.appendChild(e);
  });
}
document.querySelectorAll(".chip").forEach(function(c){
  c.addEventListener("click",function(){
    document.querySelectorAll(".chip").forEach(function(o){o.setAttribute("aria-pressed","false")});
    c.setAttribute("aria-pressed","true");render(c.dataset.f);
  });
});
render("all");

var MAIL="yuvraj@6ixcreators.com";
function route(){
  var h=location.hash.slice(1);
  var v=(h==="brand"||h==="creator")?h:"home";
  ["home","brand","creator"].forEach(function(n){document.getElementById("view-"+n).hidden=(n!==v)});
  if(v!=="home"){window.scrollTo(0,0);return}
  var t=h&&document.getElementById(h);
  if(t){t.scrollIntoView()}else{window.scrollTo(0,0)}
}
window.addEventListener("hashchange",route);
route();



document.getElementById("csend").addEventListener("click",function(){
  var f=document.getElementById("cform");
  if(!f.reportValidity())return;
  var d=new FormData(f);
  var body="Name: "+d.get("Name")+"\nEmail: "+d.get("Email")+"\n\n"+d.get("Message");
  window.location.href="mailto:info@6ixcreators.com?subject="+encodeURIComponent("6ix Creators inquiry")+"&body="+encodeURIComponent(body);
});
})();
</script>
