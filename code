      <li><b>Post</b>The creator publishes and we collect results.</li>
    </ol>
  </section>

  <section id="board">
    <h2>Open campaigns</h2>
    <p style="color:var(--muted);max-width:56ch;margin:0">This is how campaigns will look to creators. Listings below are samples.</p>
    <div class="chips" role="group" aria-label="Filter campaigns">
      <button class="chip" data-f="all" aria-pressed="true">All</button>
      <button class="chip" data-f="Makeup" aria-pressed="false">Makeup</button>
      <button class="chip" data-f="Skincare" aria-pressed="false">Skincare</button>
      <button class="chip" data-f="Hair" aria-pressed="false">Hair</button>
